{
  "name": "@kevin-courbet/agent-browser",
  "version": "0.1.0",
  "description": "CLI-driven browser control for coding agents using Playwright over CDP.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevin-courbet/agent-browser.git"
  },
  "bugs": {
    "url": "https://github.com/kevin-courbet/agent-browser/issues"
  },
  "homepage": "https://github.com/kevin-courbet/agent-browser#readme",
  "keywords": ["browser", "automation", "playwright", "cdp", "cli", "agent"],
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=22.0.0"
  },
  "bin": {
    "ab": "./src/cli/index.ts"
  },
  "scripts": {
    "daemon": "node --experimental-strip-types --experimental-transform-types --disable-warning=ExperimentalWarning src/daemon/index.ts",
    "cli": "bun src/cli/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "playwright": "^1.59.1",
    "yaml": "^2.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
